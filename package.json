{
  "name": "ievoide",
  "productName": "ievoide — 自进化 dev Tool",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "demo": "node demo.mjs",
    "start": "node start.mjs",
    "restart": "bash dev-restart.sh",
    "dev": "node dev-watch.mjs",
    "dryrun": "node --check main.js && node --check preload.cjs && node --check renderer/renderer.js && node --check renderer/pdfeditor.js && echo 'dry-run OK'",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "anthropic",
    "electron",
    "ai-coding-agent",
    "self-evolving",
    "desktop-app"
  ],
  "author": "a21989s",
  "license": "MIT",
  "description": "Self-evolving desktop AI dev tool built on the Claude Agent SDK: parallel chats, full source control, PDF/Markdown/Mermaid editing, mobile remote access, and an agent that can rewrite its own source code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/a21989s/ievoide.git"
  },
  "homepage": "https://github.com/a21989s/ievoide#readme",
  "bugs": {
    "url": "https://github.com/a21989s/ievoide/issues"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.169",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205"
  },
  "type": "module",
  "devDependencies": {
    "electron": "^42.3.3"
  }
}